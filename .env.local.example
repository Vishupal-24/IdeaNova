# Google Gemini API key — required for every AI feature in this app.
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key — optional. If set, AI requests automatically fall back to
# Groq's Llama 3.3 70B model when Gemini is slow (>12s) or unavailable.
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
